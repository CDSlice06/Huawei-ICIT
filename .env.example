# ===== MemWeave 环境变量模板（design.md §2.8.3）=====
# 复制本文件为 .env 并填入真实值；.env 不提交至代码仓库（spec §4.3.4）

# 数据库（RDS for MySQL 8.0）
DATABASE_URL=mysql+aiomysql://user:password@host:3306/memweave

# Redis（容器部署时由 compose 注入 redis://redis:6379/0，可切换华为云托管实例）
# REDIS_URL=redis://host:6379/0

# 会话有效期（小时，≥24）
SESSION_TTL_HOURS=24

# 演示账号远程重置运维令牌（POST /api/admin/demo/reset 的 Bearer Token）
ADMIN_TOKEN=

# MaaS 大模型服务
MAAS_API_KEY=
MAAS_ENDPOINT=
MAAS_TEXT_TIMEOUT=30
MAAS_MULTIMODAL_TIMEOUT=120

# OBS 对象存储
OBS_AK=
OBS_SK=
OBS_BUCKET=memweave-assets
OBS_ENDPOINT=

# 演示账号（预置示例数据）
DEMO_ACCOUNT_EMAIL=demo@memweave.cn
DEMO_ACCOUNT_PASSWORD=

# 调度器开关（多 worker 下仅持 Redis SETNX 锁的 worker 激活）
ENABLE_SCHEDULER=true